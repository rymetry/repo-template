{
  "command-policy": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env bash \"$(git rev-parse --show-toplevel)/.agents/hooks/antigravity-pre-tool-use.sh\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
